---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = '细林的 Agentic Lab —— vibecoding 之后的技术实验场：大模型 · Harness · Loop · Graph',
  current = '',
} = Astro.props;

const chapters = [
  { slug: 'model', label: '大模型' },
  { slug: 'harness', label: 'Harness' },
  { slug: 'loop', label: 'Loop' },
  { slug: 'graph', label: 'Graph' },
  { slug: 'notes', label: '文章' },
  { slug: 'cases', label: '案例' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="细林 · Agentic Lab" />
    <meta property="og:image" content="https://chenxilin1994.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://chenxilin1994.github.io/og.png" />
    <link rel="alternate" type="application/rss+xml" title="细林 · Agentic Lab" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <div class="bg-grid fixed inset-0 -z-10 pointer-events-none" aria-hidden="true"></div>

    <header class="sticky top-0 z-40 border-b border-[var(--color-line)] backdrop-blur-md bg-[rgba(10,10,19,0.72)]">
      <nav class="max-w-5xl mx-auto px-5 h-14 flex items-center gap-5">
        <a href="/" class="flex items-center gap-2.5 shrink-0 group">
          <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
            <path d="M32 14a18 18 0 1 1-12.7 5.3" fill="none" stroke="#6d8dff" stroke-width="6" stroke-linecap="round"/>
            <path d="M18 12v10h10" fill="none" stroke="#a78bfa" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="32" cy="32" r="5" fill="#2dd4bf"/>
          </svg>
          <span class="text-sm font-medium tracking-wide">
            细林 <span class="hidden sm:inline"><span class="text-[var(--color-faint)]">·</span> <span class="font-monox text-[var(--color-mute)] group-hover:text-[var(--color-acc)] transition-colors">Agentic Lab</span></span>
          </span>
        </a>

        <div class="flex items-center gap-1 text-[13px] overflow-x-auto [mask-image:linear-gradient(to_right,black_85%,transparent)]">
          {
            chapters.map((c) => (
              <a
                href={`/${c.slug}/`}
                class:list={[
                  'px-2.5 py-1.5 rounded-md transition-colors whitespace-nowrap',
                  current === c.slug
                    ? 'text-[var(--color-ink)] bg-[rgba(109,141,255,0.14)]'
                    : 'text-[var(--color-mute)] hover:text-[var(--color-ink)] hover:bg-[rgba(148,163,255,0.08)]',
                ]}
              >
                {c.label}
              </a>
            ))
          }
          <a
            href="/meta/"
            class:list={[
              'px-2.5 py-1.5 rounded-md transition-colors whitespace-nowrap',
              current === 'meta'
                ? 'text-[var(--color-ink)] bg-[rgba(109,141,255,0.14)]'
                : 'text-[var(--color-mute)] hover:text-[var(--color-ink)] hover:bg-[rgba(148,163,255,0.08)]',
            ]}
          >
            Meta
          </a>
        </div>

        <a
          href="https://github.com/chenxilin1994/chenxilin1994.github.io"
          target="_blank"
          rel="noopener"
          class="ml-auto text-[var(--color-faint)] hover:text-[var(--color-ink)] transition-colors shrink-0"
          aria-label="GitHub 仓库"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>
      </nav>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-line)] mt-24">
      <div class="max-w-5xl mx-auto px-5 py-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-[13px] text-[var(--color-faint)]">
        <span>本站由 AI agent 与细林协作构建 · <a href="/meta/" class="text-[var(--color-mute)] hover:text-[var(--color-acc)] transition-colors underline decoration-dotted underline-offset-4">构建日志</a></span>
        <span class="font-monox">model → harness → loop → graph</span>
        <span class="ml-auto">旧博客已封存于 git 历史 · 2026</span>
      </div>
    </footer>
  </body>
</html>
